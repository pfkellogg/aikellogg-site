)\n        h = 240u - y;\n    for (r = 0; r < h; r++) {\n        uint32_t yy = y + r, s, a0 = 0, b0 = 0, run = 0;\n        uint16_t nh[BS_NSEG];\n        for (i = 0; i < w; i++)\n            bs_row[i] = px ? (uint16_t)((px[r * w + i] >> 8) | (px[r * w + i] << 8)) : c;\n        for (s = x / BS_SEGW; s <= (x + w - 1u) / BS_SEGW; s++) {\n            uint32_t a = s * BS_SEGW > x ? s * BS_SEGW : x, b = (s + 1u) * BS_SEGW < x + w ? (s + 1u) * BS_SEGW : x + w;\n            int whole = a == s * BS_SEGW && b == (s + 1u) * BS_SEGW, changed = 1;\n            nh[s] = 0;\n            if (whole) {\n                nh[s] = bs_seg_hash(bs_row + (a - x), BS_SEGW);\n                changed = nh[s] != bs_hash[yy][s];\n            }\n            if (changed && run && a == b0) {     /* (joins the run before it) */\n                b0 = b;\n                continue;\n            }\n            if (run) {                           /* the run before it goes */\n                bs_run(x, a0, b0, yy, start, nh);\n                run = 0;\n            }\n            if (changed) {\n                a0 = a;\n                b0 = b;\n                run = 1;\n            }\n        }\n        if (run)\n            bs_run(x, a0, b0, yy, start, nh);\n    }\n}"},"asm":[[33556280,"7f 04","[--sp] = {rets, r15-r4}",null],[33556282,"e2 8f","sp += -68",null],[33556284,"c4 ff e0 21 c1 01","r4 = 29434336 <flash_ok : 1c121e0 >","flash_ok"],[33556290,"45 69","r5 = [r4+36]",null],[33556292,"05 d6","r5 = r0  #",null],[33556294,"85 29","[sp+36] = r5",null],[33556296,"d0 ec 40 65","r6 = [r4+80]",null],[33556300,"40 21","r0 = 1",null],[33556302,"06 41","if (r6 == 0) goto 2 <bs_lcd+0x1A : 2000752 >",null],[33556304,"40 20","r0 = 0",null],[33556306,"11 fc c8 de","if (r1 > 239) goto 400 <bs_lcd+0x1AE : 20008e6 >",null],[33556310,"15 fc c6 de","if (r5 > 239) goto 396 <bs_lcd+0x1AE : 20008e6 >",null],[33556314,"02 f8 c4 00","if (r2 == 0) goto 392 <bs_lcd+0x1AE : 20008e6 >",null],[33556318,"50 ee 44 45","r4 = b[r4+84]