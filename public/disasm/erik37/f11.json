{"bs_run":{"c":{"file":"app/big_screen.c","line":142,"def_line":142,"code":"static void bs_run(uint32_t x, uint32_t a0, uint32_t b0, uint32_t yy, uint32_t start, const uint16_t *nh)\n{\n    uint32_t k, ok = bs_queue(x, a0, b0, yy, start);\n    for (k = a0 / BS_SEGW; k <= (b0 - 1u) / BS_SEGW; k++)\n        bs_hash[yy][k] = ok ? nh[k] : 0u;\n    if (!ok)\n        bs_redo = 1;\n}"},"asm":[[33556100,"7d 04","[--sp] = {rets, r13-r4}",null],[33556102,"e2 9f","sp += -4",null],[33556104,"ca ff e0 21 c1 01","r10 = 29434336 <flash_ok : 1c121e0 >","flash_ok"],[33556110,"d0 ec a4 c2","r12 = [r10+36]",null],[33556114,"28 16","r8 = r2",null],[33556116,"16 16","r6 = r1",null],[33556118,"44 21","r4 = 1",null],[33556120,"a7 1f","r7 = r2 - r6",null],[33556122,"60 1e","r0 = r6 - r0",null],[33556124,"00 a1","r0 = r0 << 1",null],[33556126,"c1 ff 10 35 c1 01","r1 = 29439248 <bs_row : 1c13510 >","bs_row"],[33556132,"0d 1c","r5 = r0 + r1",null],[33556134,"3b d6","r11 = r3  #",null],[33556136,"84 20","[sp] = r4",null],[33556138,"50 16","r0 = r5",null],[33556140,"61 16","r1 = r6",null],[33556142,"b2 16","r2 = r11",null],[33556144,"73 16","r3 = r7",null],[33556146,"bf ea ec fe","call -552 <sm_rows : 200048e >","sm_rows"],[33556150,"00 5f","if (r0 == 0) goto 62 <bs_run+0x72 : 20006f6 >","bs_run"],[33556152,"49 28","r1 = 40",null],[33556154,"f4 e1 60 01","r0 = r6 / r1 (u)",null],[33556158,"32 e1 ff 8f","r2 = r8 + -1",null],[33556162,"f4 e1 20 11","r1 = r2 / r1 (u)",null],[33556166,"01 ec 10 00","if (r0 > r1) goto 32 <bs_run+0x66 : 20006ea >","bs_run"],[33556170,"e3 f1 0c b0","r3 = r11 * 0xC  #",null],[33556174,"02 2d","r2 = [sp+52]",null],[33556176,"c5 ff 70 90 c0 01","r5 = 29397104 <bs_hash : 1c09070 >","bs_hash"],[33556182,"53 18","r3 += r5",null],[33556184,"45 20","r5 = 0",null],[33556186,"04 42","if (r4 == 0) goto 4 <bs_run+0x5C : 20006e0 >",null],[33556188,"d8 ed 28 50","r5 = h[r2+r0<<1] (u)",null],[33556192,"d8 ed 39 50","h[r3+r0<<1] = r5",null],[33556196,"c0 21","r0 += 1",null],[33556198